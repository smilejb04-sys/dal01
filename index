<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>손맛분식 고객응대 챗봇</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Noto Sans KR Font -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        market: {
                            50: '#fff7ed',
                            100: '#ffedd5',
                            200: '#fed7aa',
                            300: '#fdba74',
                            400: '#fb923c',
                            500: '#f97316',
                            600: '#ea580c',
                            700: '#c2410c',
                            800: '#9a3412',
                            900: '#7c2d12',
                        }
                    },
                    fontFamily: {
                        sans: ['Noto Sans KR', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar for chat area */
        #chat-messages::-webkit-scrollbar {
            width: 6px;
        }
        #chat-messages::-webkit-scrollbar-track {
            background: #fff7ed;
        }
        #chat-messages::-webkit-scrollbar-thumb {
            background-color: #fdba74;
            border-radius: 10px;
        }
        /* Message animations */
        .message-anim {
            animation: fadeIn 0.25s ease-out forwards;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-amber-50/50 font-sans text-gray-800 antialiased h-screen flex justify-center items-center p-0 md:p-4">

    <!-- Main Application Wrapper (Mobile Frame View) -->
    <div class="w-full max-w-md h-full md:h-[90vh] md:max-h-[820px] bg-white flex flex-col shadow-2xl md:rounded-3xl overflow-hidden relative border border-orange-100">
        
        <!-- Header Section -->
        <header class="bg-gradient-to-r from-orange-500 to-amber-500 text-white px-5 py-4 shadow-md flex-shrink-0 relative z-10">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-11 h-11 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center text-white border border-white/30 text-xl shadow-inner">
                        <i class="fa-solid fa-utensils"></i>
                    </div>
                    <div>
                        <div class="flex items-center space-x-1.5">
                            <h1 class="font-bold text-lg leading-tight tracking-tight">손맛분식</h1>
                            <span class="bg-orange-700/40 text-amber-100 text-[10px] font-medium px-2 py-0.5 rounded-full border border-amber-200/30">달빛시장</span>
                        </div>
                        <p class="text-xs text-orange-100 flex items-center mt-0.5">
                            <i class="fa-solid fa-location-dot text-amber-200 mr-1 text-[10px]"></i> 달빛시장 3번 골목
                        </p>
                    </div>
                </div>
                <!-- Status Badge -->
                <div class="text-right">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-100 border border-emerald-300/30">
                        <span class="w-2 h-2 mr-1.5 bg-emerald-400 rounded-full animate-pulse"></span> 영업 상담중
                    </span>
                </div>
            </div>
            
            <!-- Operating Hours Banner -->
            <div class="mt-3 pt-2.5 border-t border-white/20 text-xs text-orange-50 flex items-center justify-between">
                <span class="flex items-center"><i class="fa-regular fa-clock mr-1.5 text-amber-200"></i> 평일 10~20시 / 토 21시까지</span>
                <span class="bg-orange-700/50 px-2 py-0.5 rounded text-[11px] font-medium text-amber-200">일요일 휴무</span>
            </div>
        </header>

        <!-- Quick Question Buttons Section -->
        <div class="bg-orange-50/80 px-4 py-2.5 border-b border-orange-100 flex-shrink-0">
            <p class="text-[11px] font-semibold text-orange-800/70 mb-1.5 flex items-center">
                <i class="fa-solid fa-bolt text-orange-500 mr-1 text-[10px]"></i> 자주 묻는 질문 선택
            </p>
            <div class="grid grid-cols-2 gap-1.5" id="quick-buttons">
                <button onclick="handleQuickAsk(0)" class="bg-white hover:bg-orange-100 text-orange-900 border border-orange-200/80 rounded-xl px-2.5 py-1.5 text-xs text-left transition font-medium flex items-center justify-between shadow-sm active:scale-95">
                    <span><i class="fa-regular fa-clock text-orange-500 mr-1"></i> 영업시간</span>
                    <i class="fa-solid fa-chevron-right text-[9px] text-orange-300"></i>
                </button>
                <button onclick="handleQuickAsk(1)" class="bg-white hover:bg-orange-100 text-orange-900 border border-orange-200/80 rounded-xl px-2.5 py-1.5 text-xs text-left transition font-medium flex items-center justify-between shadow-sm active:scale-95">
                    <span><i class="fa-solid fa-map-pin text-orange-500 mr-1"></i> 위치 안내</span>
                    <i class="fa-solid fa-chevron-right text-[9px] text-orange-300"></i>
                </button>
                <button onclick="handleQuickAsk(2)" class="bg-white hover:bg-orange-100 text-orange-900 border border-orange-200/80 rounded-xl px-2.5 py-1.5 text-xs text-left transition font-medium flex items-center justify-between shadow-sm active:scale-95">
                    <span><i class="fa-solid fa-star text-orange-500 mr-1"></i> 대표 메뉴</span>
                    <i class="fa-solid fa-chevron-right text-[9px] text-orange-300"></i>
                </button>
                <button onclick="handleQuickAsk(6)" class="bg-white hover:bg-orange-100 text-orange-900 border border-orange-200/80 rounded-xl px-2.5 py-1.5 text-xs text-left transition font-medium flex items-center justify-between shadow-sm active:scale-95">
                    <span><i class="fa-solid fa-gift text-orange-500 mr-1"></i> 상품권/카드</span>
                    <i class="fa-solid fa-chevron-right text-[9px] text-orange-300"></i>
                </button>
            </div>
        </div>

        <!-- Chat History Scrollable Area -->
        <main id="chat-messages" class="flex-1 p-4 overflow-y-auto space-y-4 bg-gradient-to-b from-orange-50/30 to-amber-50/20">
            <!-- Welcome Bot Message -->
            <div class="flex items-start space-x-2.5 message-anim">
                <div class="w-8 h-8 rounded-full bg-orange-500 flex items-center justify-center text-white text-xs font-bold shadow flex-shrink-0 mt-0.5">
                    손맛
                </div>
                <div class="max-w-[80%]">
                    <div class="bg-white border border-orange-100 rounded-2xl rounded-tl-xs p-3.5 shadow-sm text-sm text-gray-800 leading-relaxed">
                        안녕하세요! 달빛시장 정이 넘치는 <b>손맛분식</b>입니다. 🧡<br>
                        궁금하신 내용을 입력하시거나 상단 <b>자주 묻는 질문</b> 버튼을 눌러주세요!
                    </div>
                    <span class="text-[10px] text-gray-400 mt-1 ml-1 block" id="welcome-time">방금 전</span>
                </div>
            </div>
        </main>

        <!-- Typing Indicator Container (Hidden by default) -->
        <div id="typing-indicator" class="hidden px-4 py-2 bg-transparent flex items-center space-x-2 text-xs text-orange-600">
            <div class="w-6 h-6 rounded-full bg-orange-100 flex items-center justify-center text-orange-500 font-bold text-[10px]">
                <i class="fa-solid fa-ellipsis animate-pulse"></i>
            </div>
            <span class="bg-white px-3 py-1.5 rounded-full border border-orange-100 shadow-sm text-gray-500">
                손맛분식 답변 준비 중...
            </span>
        </div>

        <!-- Bottom Input Area -->
        <footer class="p-3 bg-white border-t border-orange-100 flex-shrink-0">
            <form id="chat-form" onsubmit="handleFormSubmit(event)" class="flex items-center space-x-2">
                <input 
                    type="text" 
                    id="user-input" 
                    placeholder="질문을 입력하세요 (예: 몇 시까지 해요?)" 
                    autocomplete="off"
                    class="flex-1 bg-amber-50/60 border border-orange-200 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:bg-white transition placeholder-gray-400"
                >
                <button 
                    type="submit" 
                    id="send-btn"
                    class="bg-orange-500 hover:bg-orange-600 active:scale-95 text-white rounded-2xl px-4 py-3 text-sm font-semibold shadow-md transition flex items-center justify-center"
                >
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </form>
            <div class="mt-2 text-center">
                <p class="text-[11px] text-gray-400">
                    <i class="fa-solid fa-circle-info mr-1"></i>FAQ에 등록된 질문만 정확히 안내해 드립니다.
                </p>
            </div>
        </footer>

    </div>

    <script>
        // FAQ 데이터베이스 (총 10개 키워드 세트 및 답변)
        const faqDatabase = [
            {
                id: 1,
                title: "영업시간",
                keywords: ["몇 시", "몇시", "언제까지", "영업시간", "열어요", "닫아요", "몇시까지", "쉬는날", "휴무", "일요일", "토요일", "시간"],
                questions: ["몇 시까지 하세요?", "언제까지 해요?", "영업시간"],
                answer: "평일은 10시부터 20시까지, 토요일은 21시까지입니다. 일요일은 쉽니다."
            },
            {
                id: 2,
                title: "위치 안내",
                keywords: ["위치", "어디", "어디에", "어떻게 가나요", "주소", "찾아가는", "골목"],
                questions: ["위치가 어디인가요?", "어떻게 가나요?", "가게 주소"],
                answer: "저희 손맛분식은 달빛시장 3번 골목 안쪽에 위치해 있습니다."
            },
            {
                id: 3,
                title: "대표 메뉴",
                keywords: ["메뉴", "대표", "맛있는", "추천", "얼마", "떡볶이", "순대", "튀김", "뭐가"],
                questions: ["대표 메뉴가 뭐예요?", "제일 맛있는 게 뭐예요?", "추천 메뉴"],
                answer: "저희 가게 대표 메뉴는 매콤달콤한 쌀떡볶이, 찰순대, 갓 튀긴 수제 튀김 세트입니다."
            },
            {
                id: 4,
                title: "주차 문의",
                keywords: ["주차", "주차장", "차량", "차 세울"],
                questions: ["주차할 수 있나요?", "주차장 있나요?"],
                answer: "달빛시장 공영주차장을 이용하시면 무료 주차권(1시간)을 드립니다."
            },
            {
                id: 5,
                title: "포장/테이크아웃",
                keywords: ["포장", "테이크아웃", "싸갈", "싸가지고"],
                questions: ["포장 가능한가요?", "테이크아웃 되나요?"],
                answer: "네, 저희 집 모든 메뉴는 깔끔하게 포장 및 테이크아웃 가능합니다."
            },
            {
                id: 6,
                title: "배달 문의",
                keywords: ["배달", "택배", "배달앱", "요기요", "배민"],
                questions: ["배달도 되나요?", "집으로 배달돼요?"],
                answer: "시장 인근 지역은 전화 주문으로 배달 가능합니다. 가게로 직접 문의해 주시면 친절히 안내해 드립니다."
            },
            {
                id: 7,
                title: "상품권/결제",
                keywords: ["상품권", "온누리", "카드", "제로페이", "지역사랑", "현금", "결제", "쓰나요"],
                questions: ["온누리상품권 쓰나요?", "카드 되나요?", "상품권 사용할 수 있나요?"],
                answer: "온누리상품권, 제로페이, 지역사랑상품권 및 신용카드 결제 모두 환영합니다."
            },
            {
                id: 8,
                title: "예약/사전주문",
                keywords: ["예약", "미리", "사전주문", "주문해놓"],
                questions: ["미리 주문 가능한가요?", "전화 예약 되나요?"],
                answer: "방문 전 전화로 미리 주문하시면 기다리지 않고 따뜻하게 바로 찾아가실 수 있습니다."
            },
            {
                id: 9,
                title: "원산지/재료",
                keywords: ["원산지", "재료", "국내산", "쌀", "식재료", "어디"],
                questions: ["재료는 어디 건가요?", "원산지가 어떻게 되나요?"],
                answer: "떡과 채소, 튀김 재료는 매일 아침 달빛시장에서 공수하는 신선한 국내산 식재료를 사용합니다."
            },
            {
                id: 10,
                title: "단체 주문",
                keywords: ["단체", "대량", "학교", "행사", "많은양", "단체주문"],
                questions: ["단체 주문 되나요?", "대량 주문 가능한가요?"],
                answer: "학교, 회사, 각종 행사용 단체 주문 가능합니다. 최소 하루 전에 가게로 연락 부탁드립니다."
            }
        ];

        // 기본 안될 때의 고정 답안 (요구사항)
        const FALLBACK_RESPONSE = "확인이 어렵습니다. 사장님께 직접 여쭤봐 주세요";

        // 초기화 타임스탬프 설정
        document.getElementById('welcome-time').innerText = getCurrentTime();

        function getCurrentTime() {
            const now = new Date();
            let hours = now.getHours();
            let minutes = now.getMinutes();
            const ampm = hours >= 12 ? '오후' : '오전';
            hours = hours % 12;
            hours = hours ? hours : 12; // 0시는 12시로 표시
            minutes = minutes < 10 ? '0' + minutes : minutes;
            return `${ampm} ${hours}:${minutes}`;
        }

        /**
         * 손님의 입력 질문에서 가장 유사한 FAQ 대답을 찾는 알고리즘
         */
        function findBestAnswer(userInput) {
            if (!userInput || userInput.trim() === '') return null;

            // 전처리: 공백 제거 및 소문자화, 특수문자 제거
            const cleanInput = userInput.replace(/[^가-힣a-zA-Z0-9\s]/g, '').trim();
            if (cleanInput.length === 0) return null;

            let bestMatch = null;
            let highestScore = 0;

            faqDatabase.forEach(faq => {
                let score = 0;

                // 1. FAQ 대표 질문들과 정확 일치 또는 포함 여부 검사
                faq.questions.forEach(q => {
                    const cleanQ = q.replace(/[^가-힣a-zA-Z0-9\s]/g, '');
                    if (cleanInput === cleanQ) {
                        score += 100; // 완벽 일치
                    } else if (cleanInput.includes(cleanQ) || cleanQ.includes(cleanInput)) {
                        score += 40; // 부분 구문 일치
                    }
                });

                // 2. 키워드 매칭
                faq.keywords.forEach(kw => {
                    if (cleanInput.includes(kw)) {
                        score += 20; // 주요 키워드 포함
                    }
                });

                // 점수가 가장 높은 FAQ 선택
                if (score > highestScore) {
                    highestScore = score;
                    bestMatch = faq;
                }
            });

            // 임계값(Threshold): 최소한의 관련성이 있을 때만 대답
            if (highestScore >= 20 && bestMatch) {
                return bestMatch.answer;
            }

            return null; // 지어내지 않고 찾지 못함을 반환
        }

        // 폼 제출 핸들러
        function handleFormSubmit(event) {
            event.preventDefault();
            const inputEl = document.getElementById('user-input');
            const question = inputEl.value.trim();

            if (!question) return;

            // 1. 사용자 메시지 화면 출력
            appendUserMessage(question);
            inputEl.value = '';

            // 2. 답변 탐색 및 응답
            processChatbotResponse(question);
        }

        // 퀵 버튼 클릭 처리
        function handleQuickAsk(index) {
            const faq = faqDatabase[index];
            if (!faq) return;

            const questionText = faq.questions[0];
            appendUserMessage(questionText);
            processChatbotResponse(questionText);
        }

        // 사용자 메시지 DOM 추가
        function appendUserMessage(text) {
            const chatMessages = document.getElementById('chat-messages');
            const timeStr = getCurrentTime();

            const userHtml = `
                <div class="flex items-start justify-end space-x-2.5 message-anim">
                    <div class="max-w-[80%] flex flex-col items-end">
                        <div class="bg-orange-500 text-white rounded-2xl rounded-tr-xs p-3.5 shadow-sm text-sm leading-relaxed">
                            ${escapeHtml(text)}
                        </div>
                        <span class="text-[10px] text-gray-400 mt-1 mr-1">${timeStr}</span>
                    </div>
                </div>
            `;

            chatMessages.insertAdjacentHTML('beforeend', userHtml);
            scrollToBottom();
        }

        // 챗봇 응답 처리 (타이핑 애니메이션 효과 적용)
        function processChatbotResponse(userInput) {
            const typingIndicator = document.getElementById('typing-indicator');
            typingIndicator.classList.remove('hidden');
            scrollToBottom();

            // 질문 매칭 실행
            const answer = findBestAnswer(userInput);
            const finalResponse = answer ? answer : FALLBACK_RESPONSE;

            // 정감있는 전달을 위한 약간의 딜레이 (0.4초)
            setTimeout(() => {
                typingIndicator.classList.add('hidden');
                appendBotMessage(finalResponse);
            }, 400);
        }

        // 챗봇 메시지 DOM 추가
        function appendBotMessage(text) {
            const chatMessages = document.getElementById('chat-messages');
            const timeStr = getCurrentTime();

            const botHtml = `
                <div class="flex items-start space-x-2.5 message-anim">
                    <div class="w-8 h-8 rounded-full bg-orange-500 flex items-center justify-center text-white text-xs font-bold shadow flex-shrink-0 mt-0.5">
                        손맛
                    </div>
                    <div class="max-w-[80%]">
                        <div class="bg-white border border-orange-100 rounded-2xl rounded-tl-xs p-3.5 shadow-sm text-sm text-gray-800 leading-relaxed">
                            ${escapeHtml(text)}
                        </div>
                        <span class="text-[10px] text-gray-400 mt-1 ml-1">${timeStr}</span>
                    </div>
                </div>
            `;

            chatMessages.insertAdjacentHTML('beforeend', botHtml);
            scrollToBottom();
        }

        // 스크롤 최하단 이동
        function scrollToBottom() {
            const chatMessages = document.getElementById('chat-messages');
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // HTML 태그 이스케이프 (보안 처리)
        function escapeHtml(string) {
            return String(string).replace(/[&<>"']/g, function (s) {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                }[s];
            });
        }
    </script>
</body>
</html>
